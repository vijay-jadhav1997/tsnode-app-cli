{
  "compilerOptions": {
    "target": "ES2022",                   // Modern JS target for Node 18+
    "module": "commonjs",                 // ESM module support
    "outDir": "./dist",                      // Compiled JS output
    "rootDir": "./src",                      // Source files location
    "strict": true,    
    "declaration": true,                    // Enable all strict type-checking options
    "esModuleInterop": true,               // For commonjs module interop
    "resolveJsonModule": true,             // Allow importing JSON files
    "moduleResolution": "node",       // Resolves imports like Node ESM
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,                  // Skip type checking for node_modules
    "allowJs": true                        // Allow JS files if needed
  },
  "include": ["src/**/*", "types/index.d.ts"],                      // Include all source files
  "exclude": ["node_modules", "dist"]      // Exclude build/output and dependencies
}
